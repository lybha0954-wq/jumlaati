# ═══════════════════════════════════════════════════
# جُمْلَتِي — Environment Variables (Template)
# انسخ هذا الملف إلى .env.local واملأ القيم
# ═══════════════════════════════════════════════════

# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ─── Web Push (VAPID) ───
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ─── Cron Security ───
CRON_SECRET=...

# ─── Optional (Future) ───
# RESEND_API_KEY=re_...
# SENTRY_DSN=https://...
